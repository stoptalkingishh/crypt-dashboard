# Copy to .env for local use (this file is git-ignored).
# Only needed if you want the values baked in at deploy/inject time;
# you can also paste them into the in-app Settings/Admin panel instead.

# Google OAuth Web client — see docs/GOOGLE-OAUTH.md.
# Use angle-bracket placeholders here; do not paste real values.
GOOGLE_CLIENT_ID=<your-oauth-web-client-id>
GOOGLE_CLIENT_SECRET=<your-oauth-client-secret>
