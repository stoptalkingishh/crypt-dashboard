# Copy to cloudflare/.env (git-ignored). Used by cloudflare/setup.sh.
#
# Token permissions:
#   Account -> Cloudflare Pages: Edit
#   Account -> Access: Apps and Policies: Edit
#   Zone    -> DNS: Edit
#   Zone    -> Zone: Read
CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>

# Non-secret constants (defaults match cryptanalyst.dev; override if needed).
CLOUDFLARE_ACCOUNT_ID=<your-account-id>
CLOUDFLARE_ZONE_ID=<your-zone-id>
PAGES_PROJECT=crypt-dashboard-secure
SECURE_HOSTNAME=home.cryptanalyst.dev
ACCESS_ALLOWED_EMAILS=<your-email>
SESSION_DURATION=24h
