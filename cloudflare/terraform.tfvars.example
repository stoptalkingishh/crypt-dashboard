# Copy to terraform.tfvars (git-ignored) and fill in your values.

cloudflare_account_id = "00000000000000000000000000000000"
cloudflare_zone_id    = "00000000000000000000000000000000"

pages_project_name = "crypt-dashboard-secure"
secure_hostname    = "home.cryptanalyst.dev"   # <-- your real Cloudflare hostname

# Who may pass the Access login.
allowed_emails         = ["you@example.com"]
allowed_email_domains  = []
require_login_methods   = ["otp"]          # or ["google"], ["github"], ["otp", "google"]...
session_duration        = "24h"

build_command    = ""
build_output_dir = "secure"
